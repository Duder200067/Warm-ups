<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#000000"><title>SCROLL — Random Video Feed</title>
<style>
*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#000;color:#fff;font-family:Arial,sans-serif}
.feed{height:100vh;overflow:hidden;scrollbar-width:none;overscroll-behavior:none;touch-action:none}
.post{height:100vh;min-height:100vh;scroll-snap-align:start;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.post:nth-child(5n+1){background:linear-gradient(135deg,#171717,#454545)}.post:nth-child(5n+2){background:linear-gradient(135deg,#102b46,#65366e)}.post:nth-child(5n+3){background:linear-gradient(135deg,#173d2c,#76551d)}.post:nth-child(5n+4){background:linear-gradient(135deg,#3c1c39,#1e3b65)}.post:nth-child(5n){background:linear-gradient(135deg,#453414,#193e43)}
.card{width:min(430px,100vw);height:100%;position:relative}.emoji{height:100%;display:flex;align-items:center;justify-content:center;font-size:clamp(80px,22vw,130px);filter:drop-shadow(0 8px 18px #0005);animation:float 3s ease-in-out infinite alternate}.post:nth-child(odd) .emoji{animation-delay:-1.5s}@keyframes float{to{transform:translateY(-14px) rotate(3deg)}}
.video-tag{position:absolute;top:76px;left:18px;padding:7px 10px;border-radius:20px;background:#0007;font-size:12px;letter-spacing:.04em}.info{position:absolute;left:18px;right:88px;bottom:30px;text-shadow:0 2px 8px #000}.user{font-weight:800;font-size:18px;margin-bottom:8px}.caption{font-size:15px;line-height:1.35}
.actions{position:absolute;right:14px;bottom:30px;display:flex;flex-direction:column;align-items:center;gap:8px}.action{width:52px;height:52px;border:0;border-radius:50%;background:#0009;color:#fff;font-size:22px;cursor:pointer}.count{font-size:12px;margin-bottom:8px}.liked{color:#ff4d6d}.top{position:fixed;z-index:5;top:14px;left:50%;transform:translateX(-50%);width:min(430px,94vw);display:flex;justify-content:space-between;pointer-events:none}.top>*{pointer-events:auto}.logo{font-weight:900;font-size:22px;text-shadow:0 2px 8px #000}.mode{border:0;border-radius:18px;background:#0008;color:#fff;padding:8px 12px;cursor:pointer}
.nav{position:fixed;z-index:6;left:max(16px,calc((100vw - 430px)/2 + 14px));top:50%;transform:translateY(-50%)}.nav button{width:52px;height:52px;border:1px solid #ffffff60;border-radius:50%;background:#0009;color:#fff;font-size:24px;cursor:pointer;backdrop-filter:blur(6px);box-shadow:0 3px 14px #0005}.nav button:hover,.nav button:focus-visible{background:#ffffff35;outline:2px solid #fff}.nav button:disabled{opacity:.45;cursor:default}.position{position:fixed;z-index:5;top:18px;left:50%;transform:translateX(-50%);margin-top:34px;font-size:12px;color:#fff9;text-shadow:0 2px 6px #000}
.position{display:none}body.light{background:#f4f4f4;color:#171717}body.light .feed{color:#fff}body.light .mode,body.light .action,body.light .nav button{background:#ffffffdc;color:#222;border-color:#2223;backdrop-filter:blur(6px)}body.light .nav button:hover,body.light .nav button:focus-visible,body.light .mode:hover,body.light .action:hover{background:#fff}body.light .logo{color:#fff}.top-controls{display:flex;gap:8px}
body.light .post:nth-child(5n+1){background:linear-gradient(135deg,#69778a,#a0a8b4)}body.light .post:nth-child(5n+2){background:linear-gradient(135deg,#6689a6,#a68bb0)}body.light .post:nth-child(5n+3){background:linear-gradient(135deg,#6e9a83,#b29a69)}body.light .post:nth-child(5n+4){background:linear-gradient(135deg,#9a7897,#718fa9)}body.light .post:nth-child(5n){background:linear-gradient(135deg,#a28d65,#6d9997)}
.comment-dialog{position:fixed;z-index:10;inset:0;display:none;align-items:flex-end;justify-content:center;background:#0008}.comment-dialog.open{display:flex}.comment-sheet{width:min(430px,100vw);max-height:72vh;overflow:auto;padding:18px;background:#171717;color:#fff;border-radius:18px 18px 0 0;box-shadow:0 -8px 30px #0007}.comment-head{display:flex;justify-content:space-between;align-items:center;font-weight:800;margin-bottom:14px}.comment-close{border:0;border-radius:50%;width:36px;height:36px;background:#ffffff20;color:inherit;font-size:20px;cursor:pointer}.comment-list{min-height:68px;max-height:34vh;overflow:auto;line-height:1.4;font-size:14px}.comment-item{padding:8px 0;border-bottom:1px solid #ffffff20;overflow-wrap:anywhere}.comment-form{display:flex;gap:8px;margin-top:12px}.comment-input{flex:1;min-width:0;border:1px solid #ffffff40;border-radius:20px;padding:10px 14px;background:#ffffff12;color:inherit;font:inherit}.comment-send{border:0;border-radius:20px;padding:0 14px;background:#fff;color:#171717;font-weight:700;cursor:pointer}body.light .comment-sheet{background:#fff;color:#171717}body.light .comment-close{background:#00000012}body.light .comment-item{border-color:#0002}body.light .comment-input{border-color:#0003;background:#f5f5f5}body.light .comment-send{background:#222;color:#fff}
.music-dialog{position:fixed;z-index:11;inset:0;display:none;align-items:flex-end;justify-content:center;background:#0008}.music-dialog.open{display:flex}.music-sheet{width:min(430px,100vw);max-height:78vh;overflow:auto;padding:18px;background:#171717;color:#fff;border-radius:18px 18px 0 0;box-shadow:0 -8px 30px #0007}.music-tracks{display:grid;gap:8px}.music-track{width:100%;text-align:left;padding:12px;border:1px solid #ffffff25;border-radius:12px;background:#ffffff10;color:inherit;font:inherit;cursor:pointer}.music-track:hover,.music-track[aria-pressed="true"]{background:#ffffff25}.music-status{min-height:20px;margin:8px 0;font-size:13px;color:#bbb}.music-player{width:100%;margin-top:8px}body.light .music-sheet{background:#fff;color:#171717}body.light .music-track{border-color:#0002;background:#00000008}body.light .music-track:hover,body.light .music-track[aria-pressed="true"]{background:#00000015}body.light .music-status{color:#555}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;scroll-behavior:auto!important}}
</style></head>
<body>
<div class="top"><div class="logo">SCROLL</div><div class="top-controls"><button class="mode" id="musicOpen" aria-label="Open songs">♫</button><button class="mode" id="mode" aria-label="Switch to light mode">☀️</button></div></div>
<nav class="nav" aria-label="Feed navigation"><button id="down" aria-label="Next video" title="Next video">↓</button></nav>
<main class="feed" id="feed" aria-label="Video feed"></main>
<div class="comment-dialog" id="commentDialog" role="dialog" aria-modal="true" aria-labelledby="commentTitle"><section class="comment-sheet"><div class="comment-head"><span id="commentTitle">Experimental comments</span><button class="comment-close" id="commentClose" aria-label="Close comments">×</button></div><div class="comment-list" id="commentList"><div class="comment-item">Comments are a little experimental — try adding one!</div></div><form class="comment-form" id="commentForm"><input class="comment-input" id="commentInput" maxlength="240" placeholder="Write a comment..." aria-label="Write a comment" required><button class="comment-send" type="submit">Post</button></form></section></div>
<div class="music-dialog" id="musicDialog" role="dialog" aria-modal="true" aria-labelledby="musicTitle"><section class="music-sheet"><div class="comment-head"><span id="musicTitle">Song playlist</span><button class="comment-close" id="musicClose" aria-label="Close songs">×</button></div><div class="music-tracks"><button class="music-track" data-src="data:audio/mpeg;base64," aria-pressed="false">Charlie’s Inferno — Excuse Me Sir (High Pitched)</button><button class="music-track" data-src="data:audio/mpeg;base64," aria-pressed="false">It’s Me, It’s Verity — Horror Skunx</button><button class="music-track" data-src="data:audio/mpeg;base64," aria-pressed="false">Bad Piggies Theme</button><button class="music-track" data-src="data:audio/mpeg;base64," aria-pressed="false">GameboyJones — HIT THE JACKPOT!</button></div><div class="music-status" id="musicStatus" aria-live="polite">Choose a song to play.</div><audio class="music-player" id="musicPlayer" controls preload="none"></audio></section></div>
<script>
const videos=[
 ['🎮','@pixelplayer','When the game finally works first try 😭','1.2K','84'],['🐸','@froggy','bro really thought nobody saw that 💀','842','31'],['🍕','@snacktime','Rate this pizza setup 1–10','3.4K','112'],['🐱','@cat.exe','loading... loading... still loading...','9.8K','260'],['🚀','@spacebox','POV: you found the secret level','2.7K','97'],
 ['🌊','@bluehour','A tiny ocean break for your feed 🌊','6.1K','143'],['🪴','@plantparent','New leaf day! Look at that color','2.2K','58'],['🐕','@goodboyclub','He heard the treat bag from three rooms away','12K','401'],['☕','@dailybrew','The perfect first pour of the morning','5.6K','180'],['🛹','@ollieplease','Finally landed it after 47 tries','3.1K','76'],
 ['🌌','@orbiting','Somewhere out there, the stars are doing this','8.3K','221'],['🍓','@berrygood','Strawberry season understood the assignment','4.7K','93'],['🎧','@lofi_lane','POV: your playlist gets you','1.9K','44'],['🦋','@littlewings','Wait for the color change 🦋','7.2K','189'],['🏀','@courtvision','Buzzer beater practice is going well','10K','332'],
 ['🧁','@sugarcloud','A little frosting therapy','3.8K','109'],['🌧️','@windowseat','Rainy day ambience, volume up','2.5K','68'],['🦊','@wildminute','Caught this curious visitor at sunrise','15K','510'],['🎨','@colorcrumbs','Turning leftover paint into something nice','4.3K','121'],['🚲','@slowride','Found a new favorite path','6.8K','205'],
 ['🍜','@noodlenight','The noodle pull was worth the wait','11K','377'],['🐙','@deepblue','Eight arms, zero bad angles','9.1K','291'],['✨','@tinywins','A reminder to celebrate the small stuff','2.1K','88'],['🏔️','@trailmix','Made it to the top before the clouds','13K','420'],['🧩','@onepieceleft','The last piece always hits different','5K','154']
];
videos.reverse();
const feed=document.getElementById('feed');
feed.innerHTML=videos.map(([emoji,user,caption,likes,comments])=>`<section class="post"><div class="card"><div class="emoji" aria-hidden="true">${emoji}</div><div class="video-tag">▶ &nbsp; VIDEO</div><div class="info"><div class="user">${user}</div><div class="caption">${caption}</div></div><div class="actions"><button class="action like" aria-label="Like video">♥</button><div class="count">${likes}</div><button class="action comments" aria-label="Open comments">💬</button><div class="count">${comments}</div><button class="action" aria-label="Share">↗</button></div></div></section>`).join('');
document.querySelectorAll('.like').forEach(b=>b.addEventListener('click',()=>b.classList.toggle('liked')));
let current=0,moving=false;const posts=[...document.querySelectorAll('.post')],nextButton=document.getElementById('down');
function updatePosition(){nextButton.disabled=current>=posts.length-1;}
function next(){if(moving||current>=posts.length-1)return;moving=true;current++;updatePosition();feed.scrollTo({top:current*feed.clientHeight,behavior:'smooth'});nextButton.disabled=true;window.setTimeout(()=>{moving=false;updatePosition();},360);}
nextButton.addEventListener('click',next);
feed.addEventListener('wheel',e=>e.preventDefault(),{passive:false});feed.addEventListener('touchmove',e=>e.preventDefault(),{passive:false});
document.addEventListener('keydown',e=>{if(e.key==='ArrowUp'){e.preventDefault()}if(e.key==='ArrowDown'){e.preventDefault();next()}});
document.getElementById('mode').addEventListener('click',()=>{document.body.classList.toggle('light');const light=document.body.classList.contains('light');const button=document.getElementById('mode');button.textContent=light?'🌙':'☀️';button.setAttribute('aria-label',light?'Switch to dark mode':'Switch to light mode');});
const dialog=document.getElementById('commentDialog'),commentInput=document.getElementById('commentInput'),commentList=document.getElementById('commentList');
function closeComments(){dialog.classList.remove('open');}
document.querySelectorAll('.comments').forEach(button=>button.addEventListener('click',()=>{dialog.classList.add('open');commentInput.focus();}));
document.getElementById('commentClose').addEventListener('click',closeComments);dialog.addEventListener('click',event=>{if(event.target===dialog)closeComments();});
document.getElementById('commentForm').addEventListener('submit',event=>{event.preventDefault();const item=document.createElement('div');item.className='comment-item';item.textContent=commentInput.value.trim();if(item.textContent){commentList.appendChild(item);commentInput.value='';commentList.scrollTop=commentList.scrollHeight;}});
document.addEventListener('keydown',event=>{if(event.key==='Escape')closeComments();});
const musicDialog=document.getElementById('musicDialog'),musicPlayer=document.getElementById('musicPlayer'),musicStatus=document.getElementById('musicStatus'),musicTracks=[...document.querySelectorAll('.music-track')];
document.getElementById('musicOpen').addEventListener('click',()=>musicDialog.classList.add('open'));
function closeMusic(){musicDialog.classList.remove('open');}
document.getElementById('musicClose').addEventListener('click',closeMusic);musicDialog.addEventListener('click',event=>{if(event.target===musicDialog)closeMusic();});
musicTracks.forEach(track=>track.addEventListener('click',async()=>{musicTracks.forEach(item=>item.setAttribute('aria-pressed','false'));track.setAttribute('aria-pressed','true');musicPlayer.src=track.dataset.src;musicStatus.textContent=`Playing: ${track.textContent}`;try{await musicPlayer.play();}catch{musicStatus.textContent=`Ready to play: ${track.textContent}`;}}));
musicPlayer.addEventListener('error',()=>{musicStatus.textContent='Could not load this song. Keep the audio folder beside index.html.';});
musicPlayer.addEventListener('pause',()=>{if(musicPlayer.currentSrc)musicStatus.textContent='Paused';});
musicPlayer.addEventListener('play',()=>{const active=musicTracks.find(track=>track.getAttribute('aria-pressed')==='true');if(active)musicStatus.textContent=`Playing: ${active.textContent}`;});
document.addEventListener('keydown',event=>{if(event.key==='Escape')closeMusic();});
updatePosition();
</script></body></html>
